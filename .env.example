# Copy to .env and fill in. The pipeline runs WITHOUT this key (deterministic tiers only);
# the key is needed only for Tier-3 LLM adjudication and the Settlement Q&A agent.
#
# CloseLoop uses Google Gemini via its OpenAI-compatible endpoint. The free tier
# is enough to run everything — NO billing required.
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_free_gemini_key_here

# Optional: override the model or point at any other OpenAI-compatible provider
# (e.g. Groq, or a local Ollama at http://localhost:11434/v1).
# CLOSELOOP_MODEL=gemini-3.6-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Razorpay TEST-MODE keys (only if you wire the live test-mode settlement API; datagen works without them)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
